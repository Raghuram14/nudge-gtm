# Public site origin used for canonical URLs, sitemap, and JSON-LD.
SITE_URL=http://localhost:3000

# Optional. If set, validated contact submissions are POSTed as JSON (no extra PII).
CONTACT_WEBHOOK_URL=

# Optional. Homepage demo visuals fetch from {ANTARANG_DEMO_API_URL}/demo/home (JSON).
# Falls back to static GTM mock when unset or on error. Keep Example badges until verified.
ANTARANG_DEMO_API_URL=
